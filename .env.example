# Path to the writing corpus directory
CORPUS_INFERENCE_PATH=~/Documents/writing-corpus

# Vector search cache location
CORPUS_INFERENCE_CACHE_PATH=~/.cache/corpus-inference-query/lance

# Embedding model (fastembed model name)
CORPUS_INFERENCE_EMBED_MODEL=BAAI/bge-base-en-v1.5

# Ollama configuration (requires [inference] extras)
CORPUS_INFERENCE_OLLAMA_BASE_URL=http://localhost:11434
CORPUS_INFERENCE_OLLAMA_MODEL=olmo3.1:32b

# Chunking parameters
CORPUS_INFERENCE_CHUNK_TARGET_TOKENS=512
CORPUS_INFERENCE_CHUNK_MAX_TOKENS=1024
CORPUS_INFERENCE_CHUNK_OVERLAP_TOKENS=64
