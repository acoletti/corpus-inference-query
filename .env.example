# corpus-inference-query environment — copy to .env.local (make init-env).
# .env.local is sourced by scripts/mcp_launcher.sh; never committed.

# Absolute path to your corpus directory (unformatted .txt/.md files are fine).
# Leave blank to use the bundled corpus/ directory shipped with this repo.
CORPUS_INFERENCE_PATH=

# Optional overrides (defaults shown):
# CORPUS_INFERENCE_CACHE_PATH=~/.cache/corpus-inference-query/lance
# CORPUS_INFERENCE_INGEST_CACHE=~/.cache/corpus-inference-query/ingest
# CORPUS_INFERENCE_EMBED_MODEL=BAAI/bge-small-en-v1.5
